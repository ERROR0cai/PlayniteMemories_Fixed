<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============ 1. 基本设置 ============ -->
    <sys:String x:Key="LOCSharpMemories_Settings_EnableAutoScreenshots">启用自动截图功能</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_IntervalLabel">间隔（分钟）：</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_IntervalUnit">分钟</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_IntervalTestModeHint">🔬 测试模式（10秒/次）</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_OutputFolderLabel">输出文件夹：</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_BrowseButton">浏览...</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_RenamePattern">重命名模式：</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_Tip_RenamePattern">可用变量: {{game}} {{date}} {{time}} {{datetime}} {{original}}</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_Tip_RenamePatternLabel">💡 {{game}} 游戏名, {{date}} 日期, {{time}} 时间, {{datetime}} 日期时间, {{original}} 原名</sys:String>

    <!-- ============ 2. 截图后缀设置 ============ -->
    <sys:String x:Key="LOCSharpMemories_Settings_SuffixTitle">截图后缀设置（将添加到文件名末尾）</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_AutoSuffix">自动截图后缀：</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_ManualSuffix">手动截图后缀：</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_SuffixPlaceholder">例如: _auto</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_SuffixEmptyHint">（留空则不添加）</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_SuffixHint">💡 后缀会自动添加在文件名末尾、扩展名之前</sys:String>

    <!-- ============ 3. ScreenshotsVisualizer 刷新 ============ -->
    <sys:String x:Key="LOCSharpMemories_Settings_EnableSVRefresh">截图后刷新 ScreenshotsVisualizer</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_Tip_EnableSVRefresh">启用后，每次截图保存后自动刷新 ScreenshotsVisualizer 插件（需已安装）</sys:String>

    <!-- ============ 4. 监控外部文件夹 ============ -->
    <sys:String x:Key="LOCSharpMemories_Settings_MonitorExternalFolder">监控外部截图文件夹</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_MonitorFolderLabel">监控文件夹：</sys:String>

    <!-- ============ 5. 截图条件设置 ============ -->
    <sys:String x:Key="LOCSharpMemories_Settings_ConditionTitle">截图条件设置</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_AllowBackgroundScreenshot">允许游戏在后台时自动截图（默认禁用）</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_Tip_AllowBackgroundScreenshot">启用后，即使游戏窗口不在前台也会自动截图。禁用时，只有当游戏窗口处于前台才会自动截图</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_Tip_SystemPause">💡 自动截图始终会在系统锁屏或息屏时暂停</sys:String>

    <!-- ============ 6. 通知设置 ============ -->
    <sys:String x:Key="LOCSharpMemories_Settings_NotificationTitle">通知设置</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_EnableNotifications">启用截图通知</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_AutoNotification">自动截图通知</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_ManualNotification">手动截图通知</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_NotificationStyle">通知样式：</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_NotificationHint">💡 Windows 通知需要 Windows 10/11 系统支持</sys:String>

    <!-- 通知消息文本 -->
    <sys:String x:Key="LOCSharpMemories_Notification_AutoCapture">自动截图</sys:String>
    <sys:String x:Key="LOCSharpMemories_Notification_ManualCapture">手动截图</sys:String>
    <sys:String x:Key="LOCSharpMemories_Notification_ScreenshotSaved">截图已保存</sys:String>
    <sys:String x:Key="LOCSharpMemories_Notification_Error">截图失败</sys:String>

    <!-- ============ 7. 热键设置 ============ -->
    <sys:String x:Key="LOCSharpMemories_Settings_HotkeyTitle">截图快捷键</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_EnableHotkey">启用截图快捷键</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_CurrentHotkeyLabel">当前快捷键：</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_SuppressHotkey">阻止快捷键传递到应用程序（防止 F12 打开浏览器开发工具等）</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_HotkeyLibrariesLabel">为以下库启用快捷键：</sys:String>

    <!-- ============ 进程截图黑名单 ============ -->
    <!-- ============ 截图进程模式 ============ -->
    <sys:String x:Key="LOCSharpMemories_ProcessMode_Title">截图进程模式</sys:String>
    <sys:String x:Key="LOCSharpMemories_ProcessMode_Hint">自动和手动截图可分别选择黑名单或白名单模式。按进程可执行文件名精确匹配，不区分大小写，输入时可省略 .exe 后缀。</sys:String>
    <sys:String x:Key="LOCSharpMemories_ProcessMode_Select">名单模式：</sys:String>
    <sys:String x:Key="LOCSharpMemories_ProcessMode_Blacklist">黑名单模式</sys:String>
    <sys:String x:Key="LOCSharpMemories_ProcessMode_Whitelist">白名单模式</sys:String>
    <!-- 自动截图进程模式 -->
    <sys:String x:Key="LOCSharpMemories_ProcessMode_AutoTitle">自动截图进程</sys:String>
    <sys:String x:Key="LOCSharpMemories_ProcessMode_AutoHint">匹配 Playnite 当前追踪的游戏进程。黑名单模式：禁止列表内进程截图；白名单模式：仅允许列表内进程截图。不影响手动截图。</sys:String>
    <!-- 手动截图进程模式 -->
    <sys:String x:Key="LOCSharpMemories_ProcessMode_ManualTitle">手动截图进程</sys:String>
    <sys:String x:Key="LOCSharpMemories_ProcessMode_ManualHint">匹配按下截图快捷键时的前台窗口进程。黑名单模式：禁止列表内进程截图；白名单模式：仅允许列表内进程截图。不影响自动截图。</sys:String>
    <!-- 添加与删除按钮：保留原资源名称 -->
    <sys:String x:Key="LOCSharpMemories_Blacklist_Add">添加</sys:String>
    <sys:String x:Key="LOCSharpMemories_Blacklist_Remove">删除</sys:String>
    <!-- 通知诊断功能：保持不变 -->
    <sys:String x:Key="LOCSharpMemories_NotificationDebug">启用通知调试日志（排查问题时开启）</sys:String>
    <!-- Notification process filtering -->
    <sys:String x:Key="LOCSharpMemories_NotificationMode_AutoHint">自动截图通知按 Playnite 追踪的游戏进程筛选。只影响成功通知，不影响截图。</sys:String>
    <sys:String x:Key="LOCSharpMemories_NotificationMode_ManualHint">手动截图通知按按下快捷键时的前台进程筛选。只影响成功通知，不影响截图。</sys:String>
    <!-- Process discovery and screenshot fallback -->
    <sys:String x:Key="LOCSharpMemories_Settings_ProcessRecheckDelay">进程二次识别延迟（秒）：</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_ProcessRecheckHint">  启动时立即识别；延迟后附加扫描，失败时定期重试</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_AllowFullScreenCapture">允许手动截图回退到整个屏幕（默认关闭）</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_Tip_AllowFullScreenCapture">关闭时，F12 仅捕获经过验证且位于前台的游戏窗口；开启后，目标窗口无法捕获时可截取整个桌面。自动截图始终不会回退至全屏。</sys:String>
    <sys:String x:Key="LOCSharpMemories_Diagnostics_Header">高级诊断（一般无需操作）</sys:String>
    <sys:String x:Key="LOCSharpMemories_Diagnostics_Description">仅用于测试截图失败占位图；会在截图目录创建一张黑底白字 ERROR 图片，不改变截图计时。</sys:String>
    <sys:String x:Key="LOCSharpMemories_Diagnostics_GenerateButton">生成 ERROR 测试图片…</sys:String>
    <sys:String x:Key="LOCSharpMemories_Diagnostics_Confirmation">此操作会在截图目录生成一张黑底白字的 ERROR 测试图，并触发错误提示（如果可用）。&#10;&#10;不会真正截取游戏画面，也不会改变自动截图倒计时。&#10;&#10;确定继续？</sys:String>
    <sys:String x:Key="LOCSharpMemories_Diagnostics_ConfirmationTitle">SharpMemories - 高级诊断确认</sys:String>
    <sys:String x:Key="LOCSharpMemories_Diagnostics_NoViewModel">当前设置界面尚未绑定配置对象。</sys:String>
    <sys:String x:Key="LOCSharpMemories_Diagnostics_Failed">创建失败，请查看 Playnite 扩展日志（extensions.log）。</sys:String>
    <sys:String x:Key="LOCSharpMemories_Diagnostics_Success">已生成 ERROR 测试图片：&#10;</sys:String>
    <sys:String x:Key="LOCSharpMemories_Diagnostics_ResultTitle">SharpMemories - 诊断结果</sys:String>
    <sys:String x:Key="LOCSharpMemories_Diagnostics_Exception">生成失败：</sys:String>
    <sys:String x:Key="LOCSharpMemories_Diagnostics_ErrorTitle">SharpMemories - 诊断错误</sys:String>

    <!-- Game window fingerprints -->
    <sys:String x:Key="LOCSharpMemories_FP_Header">每个游戏的进程和窗口指纹</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_Hint">默认仅辅助识别；强制模式仅接受符合保存规则的窗口，不回退普通识别。PID 与 HWND 不会持久化。</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_Refresh">刷新游戏列表</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_Observations">已记录的窗口样本（选中后可设为首选）</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_UseSample">使用选中窗口作为首选</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_Exe">首选可执行文件完整路径（可选）</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_Title">正式游戏窗口标题包含（建议填写）</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_Exclude">排除启动器窗口标题包含（可选）</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_Class">窗口类名（可选）</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_Force">强制匹配：仅使用以上规则选择窗口（不回退普通识别）</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_Save">保存该游戏的指纹规则</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_File">指纹另存为插件数据目录中的 GameWindowFingerprints.xml，可自行编辑或备份。</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_NeedTitle">强制模式必须填写正式游戏标题或窗口类名，否则无法区分启动器与游戏。</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_Saved">已保存该游戏的识别规则；后续识别立即使用。</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_ExcludeSample">将选中窗口标记为启动器并排除</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_SaveFailed">保存失败，请检查插件数据目录的写入权限。</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_Games">游戏列表</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_Search">搜索游戏名称或 ID</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_Mode">匹配模式</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_ModeNone">自动模式（下述配置文件不生效）</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_ModePreferred">优先模式（有匹配窗口优先，否则自动识别）</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_ModeForced">强制模式（只使用匹配窗口）</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_ModeHint">优先模式下，匹配窗口存在但不在前台时等待；没有匹配窗口才回退普通识别。</sys:String>
</ResourceDictionary>