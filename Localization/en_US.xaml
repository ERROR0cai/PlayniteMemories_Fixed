<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============ 1. Basic Settings ============ -->
    <sys:String x:Key="LOCSharpMemories_Settings_EnableAutoScreenshots">Enable automatic screenshots</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_IntervalLabel">Interval (minutes):</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_IntervalUnit">minutes</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_IntervalTestModeHint">🔬 Test Mode (10s interval)</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_OutputFolderLabel">Output folder:</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_BrowseButton">Browse...</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_RenamePattern">Rename pattern:</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_Tip_RenamePattern">Available variables: {{game}} {{date}} {{time}} {{datetime}} {{original}}</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_Tip_RenamePatternLabel">💡 {{game}} game name, {{date}} date, {{time}} time, {{datetime}} date time, {{original}} original name</sys:String>

    <!-- ============ 2. Screenshot Suffix Settings ============ -->
    <sys:String x:Key="LOCSharpMemories_Settings_SuffixTitle">Screenshot Suffix Settings (appended to filename)</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_AutoSuffix">Auto screenshot suffix:</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_ManualSuffix">Manual screenshot suffix:</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_SuffixPlaceholder">e.g.: _auto</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_SuffixEmptyHint">(leave empty to not add)</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_SuffixHint">💡 Suffix will be added at the end of filename, before extension</sys:String>

    <!-- ============ 3. ScreenshotsVisualizer Refresh ============ -->
    <sys:String x:Key="LOCSharpMemories_Settings_EnableSVRefresh">Refresh ScreenshotsVisualizer after capture</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_Tip_EnableSVRefresh">Auto-refresh ScreenshotsVisualizer plugin after each screenshot (requires installed plugin)</sys:String>

    <!-- ============ 4. Monitor External Folder ============ -->
    <sys:String x:Key="LOCSharpMemories_Settings_MonitorExternalFolder">Monitor external screenshot folder</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_MonitorFolderLabel">Monitor folder:</sys:String>

    <!-- ============ 5. Screenshot Condition Settings ============ -->
    <sys:String x:Key="LOCSharpMemories_Settings_ConditionTitle">Screenshot Condition Settings</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_AllowBackgroundScreenshot">Allow auto screenshot when game is in background (disabled by default)</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_Tip_AllowBackgroundScreenshot">When enabled, auto screenshot works even if game is not in foreground. When disabled, auto screenshot only works when game is in foreground</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_Tip_SystemPause">💡 Auto screenshot is always paused when system is locked or screen is off</sys:String>

    <!-- ============ 6. Notification Settings ============ -->
    <sys:String x:Key="LOCSharpMemories_Settings_NotificationTitle">Notification Settings</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_EnableNotifications">Enable Screenshot Notifications</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_AutoNotification">Auto Screenshot Notification</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_ManualNotification">Manual Screenshot Notification</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_NotificationStyle">Notification style:</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_NotificationHint">💡 Windows notifications require Windows 10/11</sys:String>

    <!-- Notification message texts -->
    <sys:String x:Key="LOCSharpMemories_Notification_AutoCapture">Auto Capture</sys:String>
    <sys:String x:Key="LOCSharpMemories_Notification_ManualCapture">Manual Capture</sys:String>
    <sys:String x:Key="LOCSharpMemories_Notification_ScreenshotSaved">Screenshot Saved</sys:String>
    <sys:String x:Key="LOCSharpMemories_Notification_Error">Screenshot Failed</sys:String>

    <!-- ============ 7. Hotkey Settings ============ -->
    <sys:String x:Key="LOCSharpMemories_Settings_HotkeyTitle">Screenshot Hotkey</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_EnableHotkey">Enable screenshot hotkey</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_CurrentHotkeyLabel">Current hotkey:</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_SuppressHotkey">Suppress hotkey from reaching the application (prevents F12 from opening browser dev tools, etc.)</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_HotkeyLibrariesLabel">Enable hotkey for these libraries:</sys:String>

    <!-- ============ Screenshot Process Modes ============ -->
    <!-- ============ Screenshot Progress Mode ============ -->
    <sys:String x:Key="LOCSharpMemories_ProcessMode_Title">Screenshot Process Modes</sys:String>
    <sys:String x:Key="LOCSharpMemories_ProcessMode_Hint">Choose blacklist or whitelist mode independently for automatic and manual screenshots. Executable filenames are matched exactly, case-insensitively. The .exe extension may be omitted.</sys:String>
    <sys:String x:Key="LOCSharpMemories_ProcessMode_Select">List mode:</sys:String>
    <sys:String x:Key="LOCSharpMemories_ProcessMode_Blacklist">Blacklist Mode</sys:String>
    <sys:String x:Key="LOCSharpMemories_ProcessMode_Whitelist">Whitelist Mode</sys:String>
    <!-- Automatic Screenshot Process Mode -->
    <sys:String x:Key="LOCSharpMemories_ProcessMode_AutoTitle">Automatic Screenshot Processes</sys:String>
    <sys:String x:Key="LOCSharpMemories_ProcessMode_AutoHint">Matches the game process tracked by Playnite. Blacklist mode blocks listed processes; whitelist mode allows only listed processes. Manual screenshots are unaffected.</sys:String>
    <!-- Manual Screenshot Process Mode -->
    <sys:String x:Key="LOCSharpMemories_ProcessMode_ManualTitle">Manual Screenshot Processes</sys:String>
    <sys:String x:Key="LOCSharpMemories_ProcessMode_ManualHint">Matches the foreground window process when the screenshot hotkey is pressed. Blacklist mode blocks listed processes; whitelist mode allows only listed processes. Automatic screenshots are unaffected.</sys:String>
    <!-- Add and Remove Buttons: Keep Existing Resource Keys -->
    <sys:String x:Key="LOCSharpMemories_Blacklist_Add">Add</sys:String>
    <sys:String x:Key="LOCSharpMemories_Blacklist_Remove">Remove</sys:String>
    <!-- Notification Debugging: Keep Unchanged -->
    <sys:String x:Key="LOCSharpMemories_NotificationDebug">Enable notification debug logging (troubleshooting)</sys:String>
    <!-- Notification process filtering -->
    <sys:String x:Key="LOCSharpMemories_NotificationMode_AutoHint">Filter automatic screenshot success notifications by the Playnite-tracked game process. Screenshots are unaffected.</sys:String>
    <sys:String x:Key="LOCSharpMemories_NotificationMode_ManualHint">Filter manual screenshot success notifications by the foreground process at hotkey time. Screenshots are unaffected.</sys:String>
    <!-- Process discovery and screenshot fallback -->
    <sys:String x:Key="LOCSharpMemories_Settings_ProcessRecheckDelay">Process recheck delay (seconds):</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_ProcessRecheckHint">  Check immediately at launch; scan again after delay and retry periodically if needed</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_AllowFullScreenCapture">Allow manual screenshot fallback to entire screen (off by default)</sys:String>
    <sys:String x:Key="LOCSharpMemories_Settings_Tip_AllowFullScreenCapture">When off, F12 captures only a verified foreground game window. When on, it may capture the entire desktop if the game window cannot be captured. Automatic screenshots never fall back to the entire screen.</sys:String>
    <sys:String x:Key="LOCSharpMemories_Diagnostics_Header">Advanced diagnostics (usually not needed)</sys:String>
    <sys:String x:Key="LOCSharpMemories_Diagnostics_Description">Test the screenshot failure placeholder by creating a black ERROR image in the screenshot folder. Does not affect the capture timer.</sys:String>
    <sys:String x:Key="LOCSharpMemories_Diagnostics_GenerateButton">Generate ERROR test image...</sys:String>
    <sys:String x:Key="LOCSharpMemories_Diagnostics_Confirmation">This will create a black ERROR test image in the screenshot folder and trigger a failure notification (if available).&#10;&#10;It will not capture gameplay or change the automatic screenshot countdown.&#10;&#10;Continue?</sys:String>
    <sys:String x:Key="LOCSharpMemories_Diagnostics_ConfirmationTitle">SharpMemories - Confirm diagnostics</sys:String>
    <sys:String x:Key="LOCSharpMemories_Diagnostics_NoViewModel">The settings view is not bound to a settings model.</sys:String>
    <sys:String x:Key="LOCSharpMemories_Diagnostics_Failed">Creation failed. Check the Playnite extension log (extensions.log).</sys:String>
    <sys:String x:Key="LOCSharpMemories_Diagnostics_Success">ERROR test image generated:&#10;</sys:String>
    <sys:String x:Key="LOCSharpMemories_Diagnostics_ResultTitle">SharpMemories - Diagnostic result</sys:String>
    <sys:String x:Key="LOCSharpMemories_Diagnostics_Exception">Generation failed: </sys:String>
    <sys:String x:Key="LOCSharpMemories_Diagnostics_ErrorTitle">SharpMemories - Diagnostic error</sys:String>

    <!-- Game window fingerprints -->
    <sys:String x:Key="LOCSharpMemories_FP_Header">Per-game process and window fingerprints</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_Hint">By default, saved data only helps rank candidates. Forced mode accepts only matching windows and never falls back. PIDs and HWNDs are not saved.</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_Refresh">Refresh games</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_Observations">Recorded window observations (select one as preferred)</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_UseSample">Use selected window as preferred</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_Exe">Preferred full executable path (optional)</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_Title">Game window title contains (recommended)</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_Exclude">Exclude launcher window title containing (optional)</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_Class">Window class name (optional)</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_Force">Force match: only select windows matching these rules (no fallback)</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_Save">Save this game’s fingerprint rules</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_File">Fingerprints are stored in the plugin data directory as GameWindowFingerprints.xml for editing or backup.</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_NeedTitle">Forced mode requires a preferred game window title or window class, to distinguish launchers from games.</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_Saved">Rules saved. Subsequent detection uses them immediately.</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_ExcludeSample">Exclude selected window as launcher</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_SaveFailed">Save failed. Check write permissions for the plugin data directory.</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_Games">Games</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_Search">Search game name or ID</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_Mode">Matching mode</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_ModeNone">Automatic Mode (Settings below do not apply)</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_ModePreferred">Preferred (use matching window if available; otherwise auto-detect)</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_ModeForced">Forced (matching windows only)</sys:String>
    <sys:String x:Key="LOCSharpMemories_FP_ModeHint">Preferred mode waits for the matching window if it exists but is not foreground; it falls back only if no matching window exists.</sys:String>
</ResourceDictionary>